# Copy these settings into backend/.env locally. Never commit credentials.
# This must be a NEW chat-only MongoDB database/cluster URI; do not reuse the
# pre-existing storefront MONGODB_URI. Keep this value private.
CHAT_MONGODB_URI=<new-chat-cluster-connection-uri>
# Generate a random secret of at least 32 characters for this chat app only.
CHAT_JWT_SECRET=<generate-a-private-random-secret-at-least-32-characters>
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Optional absolute path for local attachment bytes; defaults to backend/uploads.
# CHAT_UPLOAD_DIR=
